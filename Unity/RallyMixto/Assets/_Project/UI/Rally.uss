/* rally mixto: ambar = fisico, cian = digital */
:root {
    --bg: rgb(8, 11, 17);
    --panel: rgba(13, 18, 27, 0.9);
    --panel-2: rgba(22, 29, 41, 0.92);
    --line: rgba(255, 255, 255, 0.09);
    --line-2: rgba(255, 255, 255, 0.16);
    --text: rgb(236, 241, 247);
    --muted: rgb(139, 151, 168);
    --dim: rgb(92, 103, 120);
    --amber: rgb(255, 194, 61);
    --amber-soft: rgba(255, 194, 61, 0.14);
    --cyan: rgb(54, 214, 255);
    --cyan-soft: rgba(54, 214, 255, 0.13);
    --red: rgb(255, 82, 99);
    --red-soft: rgba(255, 82, 99, 0.15);
    --green: rgb(77, 255, 166);
    --violet: rgb(176, 146, 255);
    --violet-soft: rgba(176, 146, 255, 0.15);
}

.root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    -unity-font: url("../Fonts/LiberationSans.ttf");
    -unity-font-definition: initial;
    color: var(--text);
    font-size: 22px;
}

.layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

.display { -unity-font: url("../Fonts/RussoOne.ttf"); -unity-font-definition: initial; }
.label-caps { -unity-font: url("../Fonts/Oswald-Bold.ttf"); -unity-font-definition: initial; letter-spacing: 3px; font-size: 15px; color: var(--muted); }

/* pantallas */
.screen {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    opacity: 0;
    translate: 0 18px;
    transition-property: opacity, translate;
    transition-duration: 0.35s, 0.45s;
    transition-timing-function: ease-out-cubic, ease-out-cubic;
}
.screen--in { opacity: 1; translate: 0 0; }

.fade { background-color: rgb(0, 0, 0); opacity: 0; transition-property: opacity; transition-duration: 0.4s; }
.fade--on { opacity: 1; }

/* barra superior */
.topbar {
    position: absolute; left: 56px; right: 56px; top: 36px; height: 52px;
    flex-direction: row; align-items: center; justify-content: space-between;
}
.brand { flex-direction: row; align-items: center; }
.brand-name { -unity-font: url("../Fonts/RussoOne.ttf"); -unity-font-definition: initial; font-size: 24px; letter-spacing: 4px; margin-left: 14px; }
.brand-name-b { color: var(--amber); }

.chip {
    flex-direction: row; align-items: center;
    background-color: var(--panel);
    border-width: 1px; border-color: var(--line);
    border-radius: 26px; height: 46px; padding: 0 18px 0 14px;
}
.chip-dot { width: 10px; height: 10px; border-radius: 5px; background-color: var(--dim); margin-right: 10px; }
.chip-dot--ok { background-color: var(--green); }
.chip-dot--warn { background-color: var(--amber); }
.chip-dot--off { background-color: var(--red); }
.chip-text { font-size: 17px; color: var(--text); }
.chip-sub { font-size: 15px; color: var(--muted); margin-left: 10px; }
.chip-sep { width: 1px; height: 20px; background-color: var(--line-2); margin: 0 14px; }

/* paneles */
.panel {
    background-color: var(--panel);
    border-width: 1px; border-color: var(--line);
    border-radius: 18px;
    padding: 26px 28px;
}
.panel-title { -unity-font: url("../Fonts/Oswald-Bold.ttf"); -unity-font-definition: initial; font-size: 15px; letter-spacing: 3px; color: var(--muted); margin-bottom: 16px; }

.eyebrow { -unity-font: url("../Fonts/Oswald-Bold.ttf"); -unity-font-definition: initial; font-size: 17px; letter-spacing: 4px; color: var(--amber); margin-bottom: 10px; }
.h1 { -unity-font: url("../Fonts/RussoOne.ttf"); -unity-font-definition: initial; font-size: 62px; color: var(--text); margin-bottom: 14px; }
.h2 { -unity-font: url("../Fonts/RussoOne.ttf"); -unity-font-definition: initial; font-size: 36px; color: var(--text); margin-bottom: 8px; }
.body { font-size: 22px; color: var(--muted); white-space: normal; }
.small { font-size: 17px; color: var(--muted); white-space: normal; }

/* botones */
.btn {
    flex-direction: row; align-items: center; justify-content: center;
    height: 64px; padding: 0 30px; margin: 0;
    border-radius: 14px; border-width: 1px;
    border-color: var(--line-2);
    background-color: var(--panel-2);
    color: var(--text);
    -unity-font: url("../Fonts/Oswald-Bold.ttf"); -unity-font-definition: initial;
    font-size: 21px; letter-spacing: 2px;
    -unity-text-align: middle-center;
    transition-property: background-color, border-color, scale, color;
    transition-duration: 0.14s;
}
.btn:hover { border-color: rgba(255, 255, 255, 0.4); background-color: rgb(34, 43, 58); scale: 1.02 1.02; }
.btn:active { scale: 0.97 0.97; }
.btn:focus { border-color: var(--cyan); }
.btn:disabled { opacity: 0.35; scale: 1 1; }
.btn--primary { background-color: var(--amber); border-color: var(--amber); color: rgb(20, 16, 6); }
.btn--primary:hover { background-color: rgb(255, 211, 112); border-color: rgb(255, 211, 112); }
.btn--primary:focus { border-color: rgb(255, 255, 255); }
.btn--ghost { background-color: rgba(0, 0, 0, 0); border-color: rgba(0, 0, 0, 0); color: var(--muted); }
.btn--ghost:hover { color: var(--text); background-color: rgba(255, 255, 255, 0.06); border-color: rgba(0, 0, 0, 0); }
.btn--danger { border-color: rgba(255, 82, 99, 0.5); color: var(--red); }
.btn--sm { height: 48px; padding: 0 18px; font-size: 17px; border-radius: 11px; }
.btn--on { background-color: var(--cyan-soft); border-color: var(--cyan); color: var(--cyan); }
.btn-row { flex-direction: row; }
.gap { width: 12px; height: 12px; }

/* splash */
.splash { align-items: center; justify-content: center; background-color: var(--bg); }
.splash-title { -unity-font: url("../Fonts/RussoOne.ttf"); -unity-font-definition: initial; font-size: 118px; letter-spacing: 10px; margin-top: 28px; }
.splash-sub { font-size: 25px; color: var(--muted); margin-top: 6px; letter-spacing: 1px; }
.splash-bar { width: 360px; height: 4px; background-color: var(--line); border-radius: 2px; margin-top: 54px; overflow: hidden; }
.splash-fill { height: 4px; width: 0; background-color: var(--amber); border-radius: 2px; }
.splash-foot { position: absolute; bottom: 52px; font-size: 17px; color: var(--dim); letter-spacing: 1px; }

/* conexion */
.connect { flex-direction: row; padding: 128px 56px 56px 56px; }
.col-left { width: 760px; }
.col-right { flex-grow: 1; margin-left: 40px; justify-content: flex-end; align-items: flex-end; }
.port-list { margin-top: 26px; margin-bottom: 22px; }
.port {
    flex-direction: row; align-items: center;
    height: 84px; padding: 0 24px; margin-bottom: 10px;
    background-color: var(--panel);
    border-width: 1px; border-color: var(--line); border-radius: 16px;
    transition-property: border-color, background-color, translate;
    transition-duration: 0.15s;
}
.port:hover { border-color: var(--line-2); background-color: var(--panel-2); translate: 4px 0; }
.port--sel { border-color: var(--amber); background-color: rgba(255, 194, 61, 0.08); }
.port-radio { width: 22px; height: 22px; border-radius: 11px; border-width: 2px; border-color: var(--dim); margin-right: 20px; align-items: center; justify-content: center; }
.port--sel .port-radio { border-color: var(--amber); }
.port-radio-in { width: 10px; height: 10px; border-radius: 5px; background-color: rgba(0, 0, 0, 0); }
.port--sel .port-radio-in { background-color: var(--amber); }
.port-name { -unity-font: url("../Fonts/RussoOne.ttf"); -unity-font-definition: initial; font-size: 30px; width: 150px; }
.port-dev { font-size: 16px; color: var(--dim); flex-grow: 1; }
.badge { -unity-font: url("../Fonts/Oswald-Bold.ttf"); -unity-font-definition: initial; font-size: 14px; letter-spacing: 2px; padding: 5px 12px; border-radius: 8px; border-width: 1px; }
.badge--usb { color: var(--amber); border-color: rgba(255, 194, 61, 0.45); background-color: var(--amber-soft); }
.badge--bt { color: var(--cyan); border-color: rgba(54, 214, 255, 0.45); background-color: var(--cyan-soft); }
.badge--sys { color: var(--muted); border-color: var(--line-2); }
.empty { padding: 26px; border-radius: 16px; border-width: 1px; border-color: var(--line-2); background-color: var(--panel); }

.status { flex-direction: row; align-items: center; margin-top: 22px; min-height: 56px; padding: 14px 18px; border-radius: 14px; background-color: rgba(0, 0, 0, 0); }
.status--info { background-color: var(--cyan-soft); }
.status--err { background-color: var(--red-soft); }
.status--ok { background-color: rgba(77, 255, 166, 0.12); }
.status-text { white-space: normal; font-size: 19px; flex-shrink: 1; flex-grow: 1; }
.status--err .status-text { color: rgb(255, 170, 178); }
.status--info .status-text { color: rgb(170, 236, 255); }
.status--ok .status-text { color: rgb(170, 255, 214); }

.guide { width: 640px; }
.guide-step { flex-direction: row; margin-top: 16px; }
.guide-num { width: 34px; height: 34px; border-radius: 17px; background-color: var(--cyan-soft); color: var(--cyan); -unity-font: url("../Fonts/RussoOne.ttf"); -unity-font-definition: initial; font-size: 17px; -unity-text-align: middle-center; margin-right: 16px; flex-shrink: 0; }
.guide-text { white-space: normal; flex-shrink: 1; font-size: 19px; color: var(--muted); }
.guide-text-b { color: var(--text); }

/* menu */
.menu { padding: 128px 56px 56px 56px; flex-direction: row; }
.mode-card {
    flex-direction: row; align-items: center;
    width: 760px; height: 150px; margin-bottom: 16px; padding: 0 30px;
    background-color: var(--panel);
    border-width: 1px; border-color: var(--line); border-radius: 20px;
    transition-property: border-color, translate, background-color;
    transition-duration: 0.16s;
}
.mode-card:hover, .mode-card:focus { border-color: var(--amber); translate: 8px 0; background-color: var(--panel-2); }
.mode-icon { width: 84px; height: 84px; margin-right: 28px; flex-shrink: 0; }
.mode-body { flex-grow: 1; flex-shrink: 1; }
.mode-title { -unity-font: url("../Fonts/RussoOne.ttf"); -unity-font-definition: initial; font-size: 32px; margin-bottom: 6px; }
.mode-desc { font-size: 19px; color: var(--muted); white-space: normal; }
.mode-tag { margin-bottom: 8px; }
.mode-go { -unity-font: url("../Fonts/RussoOne.ttf"); -unity-font-definition: initial; font-size: 34px; color: var(--dim); margin-left: 20px; }
.mode-card:hover .mode-go, .mode-card:focus .mode-go { color: var(--amber); }

.tele { width: 520px; }
.tele-row { flex-direction: row; align-items: center; justify-content: space-between; margin-top: 12px; }
.tele-key { font-size: 18px; color: var(--muted); }
.tele-val { -unity-font: url("../Fonts/RussoOne.ttf"); -unity-font-definition: initial; font-size: 20px; }
.tele-val--amber { color: var(--amber); }
.tele-val--cyan { color: var(--cyan); }
.tele-val--red { color: var(--red); }
.tele-val--green { color: var(--green); }

/* hud */
.hud-top { position: absolute; top: 36px; left: 0; right: 0; align-items: center; }
.timer { -unity-font: url("../Fonts/RussoOne.ttf"); -unity-font-definition: initial; font-size: 64px; letter-spacing: 2px; }
.timer--warn { color: var(--red); }
.timebar { width: 360px; height: 6px; border-radius: 3px; background-color: var(--line); margin-top: 6px; overflow: hidden; }
.timebar-fill { height: 6px; background-color: var(--amber); border-radius: 3px; }
.score-box { position: absolute; left: 56px; top: 112px; }
.score { -unity-font: url("../Fonts/RussoOne.ttf"); -unity-font-definition: initial; font-size: 58px; color: var(--text); }
.score-sub { flex-direction: row; align-items: center; margin-top: 2px; }
.cell-ico { width: 18px; height: 26px; margin-right: 8px; }
.cell-count { -unity-font: url("../Fonts/RussoOne.ttf"); -unity-font-definition: initial; font-size: 22px; color: var(--cyan); margin-right: 24px; }
.hits-count { -unity-font: url("../Fonts/RussoOne.ttf"); -unity-font-definition: initial; font-size: 22px; color: var(--red); }

.feed { position: absolute; left: 56px; bottom: 48px; width: 470px; padding: 20px 22px; }
.feed-item { flex-direction: row; align-items: center; height: 40px; opacity: 1; transition-property: opacity, translate; transition-duration: 0.3s; }
.feed-item--new { opacity: 0; translate: -16px 0; }
.feed-tag { -unity-font: url("../Fonts/Oswald-Bold.ttf"); -unity-font-definition: initial; font-size: 13px; letter-spacing: 2px; width: 92px; height: 26px; border-radius: 7px; -unity-text-align: middle-center; margin-right: 14px; border-width: 1px; }
.feed-tag--LED { color: var(--amber); border-color: rgba(255, 194, 61, 0.45); background-color: var(--amber-soft); }
.feed-tag--SONIDO { color: var(--violet); border-color: rgba(176, 146, 255, 0.45); background-color: var(--violet-soft); }
.feed-tag--CARRO { color: var(--red); border-color: rgba(255, 82, 99, 0.45); background-color: var(--red-soft); }
.feed-text { font-size: 18px; color: var(--text); flex-shrink: 1; }

.dash { position: absolute; right: 56px; bottom: 48px; flex-direction: row; align-items: flex-end; padding: 20px 24px; }
.dash-block { align-items: center; margin-left: 22px; }
.dash-cap { -unity-font: url("../Fonts/Oswald-Bold.ttf"); -unity-font-definition: initial; font-size: 13px; letter-spacing: 2px; color: var(--muted); margin-top: 10px; }

.gauge-val { position: absolute; left: 0; right: 0; top: 52px; -unity-text-align: middle-center; -unity-font: url("../Fonts/RussoOne.ttf"); -unity-font-definition: initial; font-size: 36px; }
.gauge-sub { position: absolute; left: 0; right: 0; top: 96px; -unity-text-align: middle-center; -unity-font: url("../Fonts/Oswald-Bold.ttf"); -unity-font-definition: initial; font-size: 14px; letter-spacing: 2px; color: var(--muted); }

.countdown { position: absolute; left: 0; right: 0; top: 330px; -unity-text-align: middle-center; -unity-font: url("../Fonts/RussoOne.ttf"); -unity-font-definition: initial; font-size: 220px; color: var(--text); scale: 1 1; transition-property: scale, opacity; transition-duration: 0.25s; text-shadow: 0 6px 24px rgba(0, 0, 0, 0.6); }
.countdown--pop { scale: 1.35 1.35; opacity: 0.4; }

.popup { position: absolute; left: 0; right: 0; top: 230px; -unity-text-align: middle-center; -unity-font: url("../Fonts/RussoOne.ttf"); -unity-font-definition: initial; font-size: 58px; transition-property: translate, opacity; transition-duration: 0.9s; transition-timing-function: ease-out-cubic; text-shadow: 0 4px 18px rgba(0, 0, 0, 0.7); }
.popup--go { translate: 0 -70px; opacity: 0; }
.popup--cyan { color: var(--cyan); }
.popup--amber { color: var(--amber); }
.popup--violet { color: var(--violet); }
.popup--red { color: var(--red); }

.effect { position: absolute; top: 150px; left: 0; right: 0; align-items: center; }
.effect-pill { flex-direction: row; align-items: center; padding: 10px 22px; border-radius: 22px; border-width: 1px; }
.effect-pill--amber { background-color: var(--amber-soft); border-color: var(--amber); }
.effect-pill--violet { background-color: var(--violet-soft); border-color: var(--violet); }
.effect-text { -unity-font: url("../Fonts/Oswald-Bold.ttf"); -unity-font-definition: initial; font-size: 18px; letter-spacing: 3px; }
.effect-pill--amber .effect-text { color: var(--amber); }
.effect-pill--violet .effect-text { color: var(--violet); }

.hint { position: absolute; top: 112px; right: 56px; font-size: 16px; color: var(--dim); }

/* overlay modal */
.modal { background-color: rgba(4, 6, 10, 0.72); align-items: center; justify-content: center; }
.modal-card { width: 640px; align-items: stretch; padding: 40px 44px; }
.modal-card .btn { margin-top: 12px; }

/* resultados */
.results { align-items: center; justify-content: center; }
.results-card { width: 980px; padding: 46px 54px; align-items: center; }
.stars { width: 300px; height: 92px; margin-bottom: 8px; }
.stats { flex-direction: row; margin: 30px 0 22px 0; }
.stat { width: 200px; align-items: center; }
.stat-val { -unity-font: url("../Fonts/RussoOne.ttf"); -unity-font-definition: initial; font-size: 56px; }
.stat-key { -unity-font: url("../Fonts/Oswald-Bold.ttf"); -unity-font-definition: initial; font-size: 14px; letter-spacing: 3px; color: var(--muted); margin-top: 4px; }
.signals { flex-direction: row; padding: 16px 22px; border-radius: 14px; background-color: rgba(255, 255, 255, 0.04); margin-bottom: 30px; align-items: center; }
.signal { flex-direction: row; align-items: center; margin: 0 14px; }
.signal-n { -unity-font: url("../Fonts/RussoOne.ttf"); -unity-font-definition: initial; font-size: 24px; margin-left: 10px; }

/* auto */
.auto { padding: 128px 56px 56px 56px; }
.steps { width: 600px; }
.step { flex-direction: row; align-items: center; height: 54px; padding: 0 16px; border-radius: 12px; margin-bottom: 4px; overflow: hidden; }
.step-fill { position: absolute; left: 0; top: 0; bottom: 0; width: 0; background-color: var(--cyan-soft); }
.step--now { background-color: rgba(255, 255, 255, 0.05); }
.step--done .step-name { color: var(--dim); }
.step-n { -unity-font: url("../Fonts/RussoOne.ttf"); -unity-font-definition: initial; font-size: 17px; width: 40px; color: var(--dim); }
.step--now .step-n { color: var(--cyan); }
.step-name { font-size: 21px; flex-grow: 1; }
.step--now .step-name { color: var(--cyan); -unity-font: url("../Fonts/RussoOne.ttf"); -unity-font-definition: initial; }
.step-dur { font-size: 17px; color: var(--muted); }
.source { flex-direction: row; align-items: center; margin-bottom: 18px; }

/* diagnostico */
.diag { padding: 128px 56px 56px 56px; flex-direction: row; }
.diag-col { flex-grow: 1; flex-basis: 0; }
.group { margin-bottom: 18px; }
.group-row { flex-direction: row; flex-wrap: wrap; }
.group-row .btn { margin: 0 10px 10px 0; }
.slider { height: 48px; justify-content: center; margin-top: 6px; }
.slider-track { height: 10px; border-radius: 5px; background-color: var(--line-2); }
.slider-fill { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 5px; background-color: var(--amber); }
.slider-thumb { position: absolute; width: 30px; height: 30px; border-radius: 15px; top: 9px; margin-left: -15px; background-color: var(--text); border-width: 3px; border-color: var(--amber); }
.log { height: 236px; overflow: hidden; }
.log-line { font-size: 15px; color: var(--muted); height: 22px; }
.log-line--tx { color: var(--amber); }

.toasts { position: absolute; top: 108px; left: 0; right: 0; align-items: center; }
.toast { padding: 14px 24px; border-radius: 14px; background-color: var(--panel-2); border-width: 1px; border-color: var(--line-2); margin-bottom: 8px; opacity: 1; transition-property: opacity, translate; transition-duration: 0.3s; }
.toast--hide { opacity: 0; translate: 0 -10px; }
.toast--err { border-color: var(--red); }
.toast-text { font-size: 19px; }

.vignette { -unity-background-scale-mode: stretch-to-fill; }
